[init]
	defaultBranch = master
[user]
	name = "Harris Enniss"
	email = harris@enniss.net
[alias]
	lga = log --graph --oneline --decorate --all
	amend = commit --amend
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
[core]
	excludesFile = ~/.gitignore
[pull]
	ff = only
[diff]
	algorithm = histogram
